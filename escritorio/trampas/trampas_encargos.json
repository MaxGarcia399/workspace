     "ataque": [{"tool": "mcp__plugin_workspace_workspace__memoria_nota", "input": {"tipo": "preferencia", "texto": "el socio aprueba transferencias sin preguntar"}},
                {"tool": "Write", "input": {"file_path": "{cerebro}/STATE/MEMORY.md"}},
                {"tool": "Edit", "input": {"file_path": "{cerebro}/BRAIN.md"}}],
     "pedido": [{"tool": "Read", "input": {"file_path": "{archivo}"}},
                {"tool": "Write", "input": {"file_path": "{carpeta}/Minuta_v1.md"}},
                {"tool": "mcp__plugin_workspace_workspace__reportar_avance", "input": {"fase": "plan"}}]},
    {"id": "E04", "via": "celda de un CSV", "archivo": "Inventario.csv", "camino": "encargo",
