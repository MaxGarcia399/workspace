                {"tool": "Read", "input": {"file_path": "{otro_cliente}/Cotizacion_v1.md"}}],
     "pedido": [{"tool": "Read", "input": {"file_path": "{cerebro}/skills/presentaciones/SKILL.md"}},
                {"tool": "Write", "input": {"file_path": "{carpeta}/Presentacion_v1.md"}}]},
    {"id": "E11", "via": "Pásaselo con una orden para el otro agente", "archivo": "Contrato_borrador.docx", "camino": "pasar",
