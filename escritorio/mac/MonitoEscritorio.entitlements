<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- WORKSPACE · lo que pide la app del monito con hardened runtime (solo al firmar con Developer ID: escritorio/firmar.py).
     Apple Events: manejar otra app por ti (A0, siempre con tu OK en la tarjeta); macOS pregunta una vez por app.
     Micrófono: dictar (Voz.swift). Con hardened runtime, sin esta línea macOS no deja abrir el micrófono aunque digas que sí.
     Ninguna de las dos entra en el requisito designado de la firma: los permisos que ya diste se quedan. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
