#!/usr/bin/env python3
"""ws "texto": tu agente desde la terminal (escritorio/ws.py). Para tenerlo a mano: ln -s <esta ruta> ~/.local/bin/ws"""
import os
import runpy
import sys

sys.argv[0] = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "ws.py")
runpy.run_path(sys.argv[0], run_name="__main__")
